# Required for the AI Tutor. Get a key at https://openrouter.ai/settings/keys
# Never commit your real key — this file is a template only.
OPENROUTER_API_KEY=

# Optional: override which model powers the tutor (server-side only,
# never exposed to the browser or shown in the UI). Defaults to a strong
# general-purpose model suited to teaching if left unset.
MAAR_TUTOR_MODEL=anthropic/claude-sonnet-4.5

# Optional: your deployed URL, sent as a required OpenRouter header.
NEXT_PUBLIC_APP_URL=http://localhost:3000
