# Required for the AI Tutor. Get a key at https://openrouter.ai/settings/keys
# Never commit your real key — this file is a template only.
OPENROUTER_API_KEY=

# Optional: override the list of models the tutor tries, in order
# (server-side only, never exposed to the browser or shown in the UI).
# Comma-separated OpenRouter model slugs. If a model is out of credit or
# rate-limited, the next one in the list is tried automatically; if every
# model in the list fails that way, the browser falls back to the local
# WebLLM tutor. Defaults to a 27-model lineup (see lib/ai/models.ts) if
# left unset — check https://openrouter.ai/models for current slugs
# before relying on the defaults in production. A shorter list means
# faster worst-case fallback to the local tutor; a longer one means more
# chances to get a cloud answer before falling back.
MAAR_TUTOR_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1-mini,google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,qwen/qwen-2.5-72b-instruct,deepseek/deepseek-chat,mistralai/mistral-large-2411,x-ai/grok-2-1212,cohere/command-r-plus,amazon/nova-pro-v1,meta-llama/llama-3.1-405b-instruct,qwen/qwen-2.5-coder-32b-instruct,mistralai/mixtral-8x22b-instruct,google/gemini-2.0-flash-001,openai/gpt-4o-mini,anthropic/claude-3.5-haiku,deepseek/deepseek-r1,meta-llama/llama-3.1-70b-instruct,qwen/qwq-32b-preview,microsoft/phi-4,nousresearch/hermes-3-llama-3.1-405b,ai21/jamba-1.5-large,mistralai/mistral-nemo,google/gemma-2-27b-it,meta-llama/llama-3.2-90b-vision-instruct,perplexity/llama-3.1-sonar-large-128k-online,thudm/glm-4-32b

# Optional: your deployed URL, sent as a required OpenRouter header.
NEXT_PUBLIC_APP_URL=https://maar-student-hub.vercel.app
