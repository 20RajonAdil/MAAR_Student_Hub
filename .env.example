# Required for the AI Tutor. Get a key at https://openrouter.ai/settings/keys
# Never commit your real key — this file is a template only.
OPENROUTER_API_KEY=

# Optional: override the list of models the tutor tries, in order
# (server-side only, never exposed to the browser or shown in the UI).
# Comma-separated OpenRouter model slugs. If a model is out of credit or
# rate-limited, the next one in the list is tried automatically; if every
# model in the list fails that way, the browser falls back to the local
# WebLLM tutor. Defaults to a 7-model lineup (see lib/ai/models.ts) if
# left unset — check https://openrouter.ai/models for current slugs
# before relying on the defaults in production.
MAAR_TUTOR_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1-mini,google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,qwen/qwen-2.5-72b-instruct,deepseek/deepseek-chat,mistralai/mistral-large-2411

# Optional: your deployed URL, sent as a required OpenRouter header.
NEXT_PUBLIC_APP_URL=https://maar-student-hub.vercel.app
